# Kopiert diese Datei nach .env.local (lokal) bzw. tragt die Werte in Vercel
# unter Project → Settings → Environment Variables ein.

# Gästecode von der Einladungskarte (Groß-/Kleinschreibung egal)
GUEST_CODE=sonnenblume2027

# Passwort für den Admin-Bereich (/admin) – muss sich vom Gästecode unterscheiden
ADMIN_CODE=bitte-ein-langes-passwort-waehlen

# Zufälliger, langer Wert zum Signieren der Anmelde-Cookies
# (z. B. erzeugen mit: openssl rand -base64 32)
SESSION_SECRET=

# Optional: öffentliche Adresse der Seite (Link-Vorschau, Kalendereintrag).
# Auf Vercel nicht nötig – dort wird automatisch die Produktions-Domain genommen.
# NEXT_PUBLIC_SITE_URL=https://christoph-und-vera.de

# Upstash Redis (wird von der Vercel-Marketplace-Integration automatisch gesetzt)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Nur lokal: Zusagen in .data/rsvps.json speichern, auch mit `npm start`
# RSVP_STORAGE=file

# Umfang der Seite: `savethedate` = nur Titelbereich und Zusage (für die Save-the-Date-Karten).
# Zum Freischalten der kompletten Seite auf `full` setzen (oder Variable löschen) und neu deployen.
# SITE_MODE=savethedate
